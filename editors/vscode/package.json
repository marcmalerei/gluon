{
  "name": "gluon-vscode",
  "displayName": "Gluon",
  "description": "Language support for Gluon tagged templates.",
  "version": "1.9.0",
  "publisher": "marcmalerei",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/marcmalerei/gluon.git", "directory": "editors/vscode" },
  "homepage": "https://marcmalerei.github.io/gluon/latest/packages/language-server/",
  "bugs": { "url": "https://github.com/marcmalerei/gluon/issues" },
  "engines": { "vscode": "^1.96.0" },
  "categories": ["Programming Languages", "Linters"],
  "activationEvents": ["onLanguage:gluon", "onLanguage:typescript", "onLanguage:javascript"],
  "main": "./extension.cjs",
  "scripts": { "package": "vsce package", "check": "node ../../scripts/validate-vscode-client.mjs" },
  "contributes": {
    "languages": [{ "id": "gluon", "aliases": ["Gluon", ".gluon"], "extensions": [".gluon"], "configuration": "./language-configuration.json" }],
    "grammars": [{ "language": "gluon", "scopeName": "source.gluon", "path": "./syntaxes/gluon.tmLanguage.json", "embeddedLanguages": { "meta.block.script.gluon": "typescript", "meta.block.style.gluon": "css", "meta.block.template.gluon": "html" } }],
    "configuration": {
      "title": "Gluon",
      "properties": {
        "gluon.languageServerPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a lockstep gluon-language-server executable. Empty uses the same-version runtime bundled with this extension."
        },
        "gluon.languageServerArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["--stdio"],
          "description": "Arguments passed to the Gluon language server."
        }
      }
    }
  },
  "dependencies": { "vscode-languageclient": "^9.0.1" },
  "devDependencies": { "@vscode/vsce": "^3.9.2", "yauzl": "3.4.0" }
}
