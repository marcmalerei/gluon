{
  "scopeName": "source.gluon",
  "fileTypes": ["gluon"],
  "name": "Gluon Single-File Component",
  "patterns": [
    { "include": "#block" },
    { "include": "#template" },
    { "include": "#tag" },
    { "include": "source.ts" }
  ],
  "repository": {
    "block": {
      "patterns": [
        { "name": "meta.block.script.gluon", "begin": "<(script)\\b[^>]*>", "beginCaptures": { "1": { "name": "entity.name.tag.script.gluon" } }, "end": "</script>", "endCaptures": { "0": { "name": "entity.name.tag.script.gluon" } }, "contentName": "source.ts", "patterns": [{ "include": "source.ts" }] },
        { "name": "meta.block.style.gluon", "begin": "<(style)\\b[^>]*>", "beginCaptures": { "1": { "name": "entity.name.tag.style.gluon" } }, "end": "</style>", "endCaptures": { "0": { "name": "entity.name.tag.style.gluon" } }, "contentName": "source.css", "patterns": [{ "include": "source.css" }] }
      ]
    },
    "template": {
      "name": "meta.block.template.gluon",
      "begin": "<template\\b[^>]*>",
      "beginCaptures": { "0": { "name": "entity.name.tag.template.gluon" } },
      "end": "</template>",
      "endCaptures": { "0": { "name": "entity.name.tag.template.gluon" } },
      "contentName": "text.html.basic",
      "patterns": [{ "include": "text.html.basic" }, { "include": "source.ts" }]
    },
    "tag": {
      "patterns": [
        { "name": "entity.name.tag.gluon", "match": "</?[A-Za-z][A-Za-z0-9-]*" },
        { "name": "entity.other.attribute-name.gluon", "match": "[.@:][A-Za-z_:][\\w:.-]*" },
        { "name": "comment.block.gluon", "begin": "<!--", "end": "-->" }
      ]
    }
  }
}
