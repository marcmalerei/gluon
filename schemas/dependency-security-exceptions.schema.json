{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["owner", "reason", "expiry", "advisory", "package"],
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "expiry": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "advisory": { "type": "string", "minLength": 1 },
          "package": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["production", "development"] },
          "severity": { "enum": ["critical", "high", "moderate", "low", "info"] }
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "exceptions"],
  "additionalProperties": false
}
